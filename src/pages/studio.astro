    padding: clamp(1.25rem, 3vw, 2.5rem);
    overflow: hidden;
    color: var(--bi0);
    animation: bands 14s linear infinite;
  }

  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--grain);
    mix-blend-mode: overlay;
    opacity: 0.45;
    pointer-events: none;
  }

  .bands {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: flex;
  }

  .bands i {
    flex-shrink: 1;
    flex-basis: 0;
    /* Overlap a hair so fractional widths never open a seam between bands. */
    margin-right: -1px;
    background: linear-gradient(180deg in oklab, var(--top), var(--bottom));
  }

  .seen .bands i {
    animation: grow-in 1100ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--n) * 70ms);
    transform-origin: bottom;
  }

  @keyframes grow-in {
    from {
      scale: 1 0;
    }
  }

  .banner-top,
  .banner-foot {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.35;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* The right edge sits on the paper band, so it takes the paper's ink. */
  .banner-top > :last-child,
  .banner-foot > :last-child {
    color: var(--on-paper);
    text-align: right;
  }

  /* The headline spans the whole banner so its text-clipped fill lines up with the bands:
     each letter takes the ink of the band it sits on. */
  .banner-title {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding: 0 clamp(1.25rem, 7cqi, 7rem);
    /* Generous to start with; the script shrinks it when the longest word would not fit. */
    font-size: min(8.5rem, 13cqi);
    line-height: 0.88;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: normal;
    color: transparent;
    background: var(--title-fill);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .seen .banner-title {
    animation: reveal 1100ms cubic-bezier(0.6, 0, 0.2, 1) 300ms both;
  }

  @keyframes reveal {
    from {
      clip-path: inset(0 0 100% 0);
      translate: 0 0.25em;
    }
    to {
      clip-path: inset(0 0 -10% 0);
    }
  }

  .banner-foot .lockup {
    color: var(--bi4);
    font-size: 1.25rem;
    text-transform: none;
    letter-spacing: 0;
  }

  /* Logo on color */
  .on-color {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
    gap: 0.5rem;
  }

  .tile {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 1rem;
    border: 0;
    border-radius: 2px;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--hair);
  }

  button.tile {
    cursor: copy;
  }

  .tile[hidden] {
    display: none;
  }

  .tile .lockup {
    transition: scale 400ms var(--ease);
  }

  .tile:hover .lockup {
    scale: 1.08;
  }

  .tile-foot {
    position: absolute;
    inset: auto 0.75rem 0.6rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .tile-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tile-foot .hex {
    opacity: 0.75;
  }

  .badge {
    margin-left: auto;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px currentColor;
    font-variant-numeric: tabular-nums;
  }

  .badge[data-pass='false'] {
    opacity: 0.6;
    text-decoration: line-through;
  }

  /* Symbol and logo sheets */
  .spec {
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    gap: 1rem;
    margin: 0;
  }

  .bracket {
    position: relative;
    width: 34%;
    height: 0.45rem;
    margin-top: 1.1rem;
    border: 1px solid var(--soft);
    border-bottom: 0;
    font-size: 0.625rem;
    color: var(--soft);
  }

  .bracket.wide {
    width: 60%;
  }

  .bracket span {
    position: absolute;
    bottom: calc(100% + 0.35rem);
    left: 50%;
    translate: -50% 0;
    white-space: nowrap;
  }

  .hero-sym {
    align-self: center;
    font-size: clamp(5rem, 10vw, 8.5rem);
    background: var(--grad);
  }

  .spec .note {
    justify-self: start;
  }

  .guides {
    align-self: center;
    position: relative;
    max-width: 100%;
    padding: 1em;
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    border: 1px dashed var(--soft);
  }

  /* Clear-space markers on two sides of the box. */
  .guides::before,
  .guides::after {
    content: 'x';
    position: absolute;
    font-size: 0.35em;
    color: var(--soft);
  }

  .guides::before {
    top: 0.45em;
    left: 50%;
    translate: -50% 0;
  }

  .guides::after {
    top: 50%;
    left: 0.6em;
    translate: 0 -50%;
  }

  .guides .lockup {
    outline: 1px solid var(--hair);
  }

  .quad {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.75rem;
  }

  .q {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 7rem;
    container-type: size;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--hair);
  }

  .q > .sym {
    font-size: 40cqmin;
    transition: scale 500ms var(--ease);
  }

  .q:hover > .sym {
    scale: 1.1;
  }

  .q.corner {
    place-items: end start;
    padding: 0.85rem;
  }

  .q.corner .lockup {
    font-size: clamp(0.625rem, 9cqi, 1rem);
  }

  .sizes {
    gap: 0.6rem;
    align-content: center;
  }

  /* The symbol at 48, 32 and 16 px, scaled down together when the tile is small. */
  .sizes span {
    display: flex;
    align-items: end;
    gap: 0.6em;
    font-size: min(48px, 26cqi);
  }

  .sizes .sym:nth-child(2) {
    font-size: 0.667em;
  }

  .sizes .sym:nth-child(3) {
    font-size: 0.333em;
  }

  .sizes small {
    font-size: 0.5625rem;
    opacity: 0.7;
  }

  /* Colors */
  .colors {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
  }

  .list-pane {
    display: grid;
    align-content: space-between;
    gap: 1.25rem;
  }

  .swatch-list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swatch-list li[hidden] {
    display: none;
  }

  .swatch-list button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    cursor: copy;
  }

  .swatch-list i {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px var(--hair);
    transition: scale 200ms var(--ease);
  }

  .swatch-list button:hover i {
    scale: 1.15;
  }

  .swatch-list span {
    display: grid;
    line-height: 1.2;
    min-width: 0;
  }

  .swatch-list b {
    font-size: 0.6875rem;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .swatch-list .hex {
    font-size: 0.5625rem;
    color: var(--soft);
  }

  .tints {
    display: flex;
    gap: 0;
  }

  .tint-col {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: copy;
    transition: flex-grow 400ms var(--ease);
  }

  .tint-col:hover {
    flex-grow: 2;
  }

  .tint-col[hidden] {
    display: none;
  }

  .tint-col i {
    flex: 1;
    min-height: 1rem;
  }

  .tint-col .base {
    flex: 1.4;
    display: grid;
    place-items: center;
    background: var(--k);
    color: var(--on);
    font-style: normal;
    font-size: 0.5rem;
    font-weight: 500;
    overflow: hidden;
  }

  /* Type */
  .type-left {
    container-type: inline-size;
    display: grid;
    align-content: space-between;
    gap: 1.5rem;
  }

  /* Sized to the pane, so wide faces like Unbounded still fit. */
  .face {
    font-size: min(2.5rem, 11cqi);
    overflow-wrap: anywhere;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .weights {
    margin-top: 0.5rem;
    font-size: 0.6875rem;
    color: var(--soft);
  }

  .family {
    margin-top: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--primary);
  }

  .spacing {
    font-size: 0.75rem;
  }

  .type-right {
    container-type: inline-size;
    display: grid;
    align-content: center;
    gap: 1.5rem;
  }

  .aa {
    font-size: min(7.5rem, 19cqi);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.9;
    background: linear-gradient(90deg in oklab, var(--light), var(--primary), var(--accent));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .alpha {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    font-size: min(0.625rem, 2.6cqi);
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  /* Posters */
  .visuals {
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 2.3fr);
  }

  .visuals > .pane:first-child {
    display: grid;
    align-content: end;
  }

  .posters {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(13rem, 1fr));
    gap: 0.75rem;
  }

  .poster {
    position: relative;
    container-type: inline-size;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: clamp(0.9rem, 1.8vw, 1.35rem);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--hair);
  }

  .p1 {
    grid-area: 1 / 1;
  }

  .p2 {
    grid-area: 2 / 1;
  }

  .p3 {
    grid-area: 1 / 2 / 3 / 3;
  }

  .p4 {
    grid-area: 1 / 3 / 3 / 4;
  }

  .poster > p {
    position: relative;
  }

  .p-head {
    font-size: clamp(1.25rem, 2.2vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    max-width: 14ch;
  }

  .p-head.big {
    font-size: clamp(1.75rem, 3.4vw, 3rem);
    font-weight: 800;
    max-width: none;
    overflow-wrap: anywhere;
  }

  .p-head.small {
    align-self: end;
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
  }

  .p-nav,
  .p-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-size: 0.5625rem;
    font-weight: 500;
    opacity: 0.85;
  }

  .p-foot {
    justify-content: space-between;
    line-height: 1.4;
  }

  .p-foot span:last-child {
    text-align: right;
  }

  .p2 .lockup {
    font-size: 0.9rem;
  }

  .arches {
    position: absolute;
    inset: 24% 6% 0;
    width: 88%;
    height: 76%;
    fill: none;
    stroke: var(--light);
    stroke-width: 0.6;
    opacity: 0.7;
  }

  .arches path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .seen .arches path {
    animation: draw 1800ms cubic-bezier(0.6, 0, 0.2, 1) both;
    animation-delay: calc(400ms + var(--n) * 90ms);
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  .giant {
    position: absolute;
    right: -35cqi;
    top: -8cqi;
    font-size: 110cqi;
    transition: rotate 1200ms var(--ease);
  }

  .p4:hover .giant {
    rotate: -8deg;
  }

  /* Applications */
  .apps {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr) minmax(0, 1.2fr);
  }

  .app-icon-stage {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1.25rem;
  }

  .stage-label {
    font-size: 0.6875rem;
    color: var(--soft);
  }

  .app {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 8rem;
    aspect-ratio: 1;
    background: var(--primary);
    color: var(--on-primary);
    font-size: 3.75rem;
    mask: var(--squircle) center / 100% 100% no-repeat;
  }

  .badge-dot {
    position: absolute;
    top: -0.6rem;
    right: -0.6rem;
    display: grid;
    place-items: center;
    min-width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 0 0 3px var(--bg);
    font-size: 1rem;
    font-weight: 700;
  }

  .seen .badge-dot {
    animation: pop 600ms cubic-bezier(0.3, 1.6, 0.5, 1) 900ms both;
  }

  @keyframes pop {
    from {
      scale: 0;
    }
  }

  .phone-stage {
    display: grid;
    place-items: center;
  }

  .phone {
    width: min(100%, 13rem);
    aspect-ratio: 9 / 18;
    padding: 0.45rem;
    border-radius: 2.1rem;
    background: #0b0b0c;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 30px 50px -30px rgb(0 0 0 / 0.6);
  }

  .screen {
    position: relative;
    height: 100%;
    padding: 2.75rem 0.9rem 1rem;
    border-radius: 1.7rem;
    /* Dark wallpaper, so the primary-colored icon always stands off it. */
    background:
      radial-gradient(120% 60% at 50% 0%, color-mix(in oklab, var(--primary) 45%, var(--deep)), transparent),
      var(--deep);
    overflow: hidden;
  }

  .clock {
    position: absolute;
    top: 0.85rem;
    left: 0;
    right: 0;
    text-align: center;
    color: var(--on-deep);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .grid-icons {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem 0.55rem;
  }

  .ghost {
    aspect-ratio: 1;
    background: color-mix(in oklab, var(--paper) 30%, transparent);
    mask: var(--squircle) center / 100% 100% no-repeat;
  }

  .app.small .icon {
    width: 100%;
    font-size: 1.05rem;
  }

  .app.small small {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.5rem;
    font-weight: 500;
    color: var(--on-deep);
  }

  .cards {
    display: grid;
    align-content: center;
    gap: 0.75rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 1.75;
    padding: 1rem 1.15rem;
    border-radius: 5px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 14px 30px -14px rgb(0 0 0 / 0.3);
    transition: rotate 700ms var(--ease);
  }

  .cards:hover .front {
    rotate: -2deg;
  }

  .cards:hover .back {
    rotate: 2deg;
  }

  .card .lockup {
    font-size: 1.1rem;
  }

  .card p {
    font-size: 0.6875rem;
    line-height: 1.45;
  }

  .back {
    position: relative;
    overflow: hidden;
  }

  .pattern {
    position: absolute;
    inset: -12% -6%;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    place-items: center;
    font-size: clamp(1rem, 2.2vw, 1.6rem);
    rotate: -12deg;
  }

  /* A wave runs diagonally across the marks. */
  .seen .pattern .sym {
    animation: wave 3.2s ease-in-out infinite;
    animation-delay: calc(var(--n) * 140ms);
  }

  @keyframes wave {
    0%,
    60%,
    100% {
      scale: 1;
      opacity: 0.9;
    }
    30% {
      scale: 0.55;
      opacity: 0.45;
    }
  }

  /* ---------- Typefaces ---------- */
  .board,
  .mini {
    font-family: var(--body);
  }

  .lock-text b,
  .bhead h2,
  .banner-title,
  .p-head,
  .face,
  .aa,
  .ui-greet,
  .ui-sheet-title {
    font-family: var(--display);
    letter-spacing: var(--track);
  }

  .bhead h2,
  .face,
  .ui-greet,
  .ui-sheet-title {
    font-weight: var(--display-weight);
  }

  /* Wordmark, posters and the banner run two steps heavier than the slide titles. */
  .lock-text b,
  .banner-title,
  .p-head,
  .p-head.big,
  .aa {
    font-weight: min(900, calc(var(--display-weight) + 200));
  }

  /* Type panel */
  .type-panel {
    width: 100%;
  }

  .type-panel summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: max-content;
    max-width: 100%;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--raised);
    font-size: var(--step--1);
    font-weight: 700;
    list-style: none;
    cursor: pointer;
    transition: border-color 160ms ease;
  }

  .type-panel summary:hover {
    border-color: var(--ink);
  }

  .type-panel summary::-webkit-details-marker {
    display: none;
  }

  .type-panel summary::after {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    rotate: 45deg;
    translate: 0 -2px;
    transition: rotate 200ms var(--ease);
  }

  .type-panel[open] summary::after {
    rotate: 225deg;
    translate: 0 2px;
  }

  .type-summary {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
    color: var(--muted);
  }

  .type-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem 1.75rem;
    margin-top: 0.75rem;
    padding: 1.1rem 1.25rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--raised);
  }

  .type-panel[open] .type-grid {
    animation: open 260ms var(--ease) both;
  }

  @keyframes open {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
  }

  .tp-field,
  .tp-font {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .tp-font legend {
    float: left;
    padding: 0;
    font-size: var(--step--1);
    font-weight: 700;
  }

  .tp-field > span,
  .tp-range > span {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .tp-field select,
  .tp-input,
  .tp-file span {
    width: 100%;
    height: 2.6rem;
    padding: 0 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--ground);
    font-weight: 500;
    outline: none;
  }

  .tp-field select:focus-visible,
  .tp-input:focus {
    border-color: var(--ink);
  }

  .tp-field select {
    cursor: pointer;
  }

  .tp-font .segment {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 10px;
  }

  .tp-font .segment button {
    padding: 0.4rem;
    border: 0;
    border-radius: 7px;
    background: none;
    color: var(--muted);
  }

  .tp-font .segment button[aria-pressed='true'] {
    background: var(--ground);
    color: var(--ink);
    box-shadow: 0 0 0 1px var(--rule);
  }

  .tp-input[hidden],
  .tp-file[hidden] {
    display: none;
  }

  .tp-file {
    position: relative;
  }

  .tp-file input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .tp-file span {
    display: flex;
    align-items: center;
    overflow: hidden;
    border-style: dashed;
    color: var(--muted);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .tp-file:hover span,
  .tp-file:has(input:focus-visible) span {
    border-color: var(--ink);
  }

  .tp-font small {
    font-size: 0.75rem;
