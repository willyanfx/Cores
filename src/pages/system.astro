<script>
  // Scroll-spy: mark the rail link for the section nearest the top.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')].map((a) => [a.dataset.spy!, a]),
  );
  const sections = [...document.querySelectorAll<HTMLElement>('[data-section]')];
  const visible = new Set<string>();
  const mark = () => {
    const current = sections.find((s) => visible.has(s.id)) ?? sections[0];
    for (const [id, a] of links) {
      if (id === current.id) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
    // Keep the active item in view on the mobile strip.
    const active = links.get(current.id);
    const strip = active?.closest<HTMLElement>('.toc');
    if (active && strip && strip.scrollWidth > strip.clientWidth) {
      const left = strip.scrollLeft + active.getBoundingClientRect().left - strip.getBoundingClientRect().left;
      strip.scrollLeft = left - 8;
    }
  };
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) visible.add(e.target.id);
        else visible.delete(e.target.id);
      }
      mark();
    },
    { rootMargin: '-15% 0px -70% 0px' },
  );
  sections.forEach((s) => io.observe(s));

  // Demo toggles behave like the real ones.
  for (const group of document.querySelectorAll('[data-toggle-group]')) {
    group.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (b) b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
    });
  }
  for (const list of document.querySelectorAll('[role=tablist]')) {
    list.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('[role=tab]');
      if (!b) return;
      list.querySelectorAll('[role=tab]').forEach((t) => t.setAttribute('aria-selected', String(t === b)));
    });
  }
</script>

