---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import PaletteCard from '../components/PaletteCard.astro';
import globalCss from '../styles/global.css?raw';
import { HUES, contrast, formatOklch, hueFamily, inkOn, oklch, wcagLevel } from '../lib/color';
import { BANDS, MONO, SHAPE, SIZE, WORDMARK, logoRamp, type LogoRamp } from '../lib/logo';
import { assignRoles, getPalettes, href } from '../lib/palettes';
import { brandRoles } from '../lib/brand';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ---------------------------------------------------------------------------
// Tokens, read from global.css so this page can't drift from the real values.
// ---------------------------------------------------------------------------
const block = (css: string) => {
  const vars: Record<string, string> = {};
  for (const m of css.matchAll(/--([\w-]+):\s*([^;]+);/g)) vars[m[1]] = m[2].trim();
  return vars;
};
const rootCss = globalCss.match(/:root\s*{([^}]*)}/)?.[1] ?? '';
const darkCss = globalCss.match(/prefers-color-scheme:\s*dark\)\s*{\s*:root\s*{([^}]*)}/)?.[1] ?? '';
const rootRaw = [
  globalCss.match(/:root\s*{[^}]*}/)?.[0],
  globalCss.match(/@media \(prefers-color-scheme:\s*dark\)\s*{\s*:root\s*{[^}]*}\s*}/)?.[0],
]
  .filter(Boolean)
  .join('\n\n');
const light = block(rootCss);
const dark = block(darkCss);

const COLOR_TOKENS: [name: string, use: string][] = [
  ['ground', 'The page. Everything sits on it.'],
  ['raised', 'Fields, selected pills and code blocks, one step up from the page.'],
  ['ink', 'Text, primary buttons, the toast and the focus ring.'],
  ['muted', 'Secondary text: counts, captions, labels.'],
  ['rule', 'Hairlines: dividers, field borders, card outlines.'],
];
const colorTokens = COLOR_TOKENS.map(([name, use]) => ({ name, use, light: light[name], dark: dark[name] }));

const TYPE_STEPS: [token: string, role: string, sample: string][] = [
  ['step-3', 'Reserved; the floor for section titles here', 'Color leads the way'],
  ['step-2', 'Section headings, large color names', 'Contrast and exports'],
  ['step-1', 'Site name in the top bar, contrast samples', 'Cores'],
  ['step-0', 'Body and card titles', 'Click any swatch to copy its value.'],
  ['step--1', 'Labels, captions, pills', '5 colors · Contrast 12:1'],
];
const typeSteps = TYPE_STEPS.map(([token, role, sample]) => ({ token, role, sample, size: light[token] }));

// ---------------------------------------------------------------------------
// Collection facts
// ---------------------------------------------------------------------------
const infos = await getPalettes();
const allHexes = [...new Set(infos.flatMap(({ palette }) => palette.data.colors.map((c) => c.hex)))];
const brandCount = infos.filter((i) => i.palette.data.origin === 'brand').length;

const byHue = [...infos].sort((a, b) => a.leadHue - b.leadHue);
const pick = (f: number) => byHue[Math.min(byHue.length - 1, Math.floor(byHue.length * f))];

// Hue families: same swatch rule as the home page filters.
const hueRows = HUES.map((h) => {
  const score = (hex: string) => {
    const { l, c } = oklch(hex);
    return h === 'neutral' ? -Math.abs(l - 0.75) : c - Math.abs(l - 0.65) * 0.3;
  };
  const hits = allHexes.filter((hex) => hueFamily(hex) === h);
  const swatch = [...hits].sort((a, b) => score(b) - score(a))[0] ?? '#888888';
  return { hue: h, swatch, colors: hits.length, palettes: infos.filter((i) => i.hues.includes(h)).length };
}).filter((r) => r.colors > 0);

// A rich palette to demonstrate roles with.
const sample =
  [...infos]
    .filter((i) => i.palette.data.colors.length >= 5 && i.palette.data.colors.length <= 7)
    .sort((a, b) => oklch(b.lead).c - oklch(a.lead).c)[0] ?? infos[0];
const sampleColors = sample.palette.data.colors;
const ui = assignRoles(sampleColors);
const brand = brandRoles(sampleColors);
const uiRoles = [
  ['background', ui.background, 'Lightest color, unless the source names one'],
  ['surface', ui.surface, 'Any color left after accent'],
  ['text', ui.text, 'Highest contrast against background'],
  ['accent', ui.accent, 'Most chromatic color'],
] as const;
const brandRoleRows = [
  ['paper', brand.paper],
  ['text', brand.text],
  ['primary', brand.primary],
  ['accent', brand.accent],
  ['surface', brand.surface],
  ['deep', brand.deep],
  ['light', brand.light],
] as const;

// Logo dressed in a few palettes spread round the hue wheel.
const logoFills = ({ ground, bands, ink }: LogoRamp) => [ground, ...bands, ink];
const logoSamples = [
  { title: 'Monochrome', ramp: MONO },
  ...[0.12, 0.45, 0.8].map((f) => {
    const p = pick(f).palette;
    return { title: p.data.title, url: href(p.id), ramp: logoRamp(p.data.colors.map((c) => c.hex)) };
  }),
].map((s, i) => ({ ...s, fills: logoFills(s.ramp), clip: `sys-logo-${i}` }));

// Cards to show the palette card component live.
const cardSamples = [pick(0.05), pick(0.38), pick(0.7)];

// ---------------------------------------------------------------------------
// Accessibility numbers, computed from the same tokens.
// ---------------------------------------------------------------------------
const fmt = (r: number) => `${r >= 10 ? r.toFixed(0) : r.toFixed(1)}:1`;
const pairRows = [
  ['ink', 'ground'],
  ['muted', 'ground'],
  ['ink', 'raised'],
  ['muted', 'raised'],
  ['ground', 'ink'],
].map(([fg, bg]) => {
  const l = contrast(light[fg], light[bg]);
  const d = contrast(dark[fg], dark[bg]);
  return { fg, bg, light: fmt(l), lightLevel: wcagLevel(l), dark: fmt(d), darkLevel: wcagLevel(d) };
});

// Do / don't: text on a light chromatic swatch.
const lightChip =
  allHexes
    .filter((h) => oklch(h).c > 0.1 && oklch(h).l > 0.8)
    .sort((a, b) => oklch(b).c - oklch(a).c)[0] ?? '#F2D14B';
const goodInk = inkOn(lightChip);
const badInk = goodInk === '#000000' ? '#FFFFFF' : '#000000';
const goodRatio = fmt(contrast(lightChip, goodInk));
const badRatio = fmt(contrast(lightChip, badInk));
const tintAccent = pick(0.45).lead;

const NAV = [
  {
    group: 'Foundation',
    items: [
      ['overview', 'Overview'],
      ['logo', 'Logo'],
      ['color', 'Color'],
      ['type', 'Typography'],
      ['layout', 'Layout'],
      ['motion', 'Motion'],
    ],
  },
  {
    group: 'Components',
    items: [
      ['swatches', 'Swatches'],
      ['controls', 'Controls'],
      ['feedback', 'Feedback'],
    ],
  },
  {
    group: 'Guidelines',
    items: [
      ['a11y', 'Accessibility'],
      ['dos', 'Do and don’t'],
      ['tokens', 'Tokens'],
    ],
  },
];
let n = 0;
const nav = NAV.map((g) => ({ ...g, items: g.items.map(([id, label]) => ({ id, label, num: String(++n).padStart(2, '0') })) }));
const num = Object.fromEntries(nav.flatMap((g) => g.items.map((i) => [i.id, i.num])));
---

<Base title="Design system · Cores" description="The tokens, type, components and rules behind Cores.">
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap"
  />

  <div class="shell">
    <aside class="rail" aria-label="Design system contents">
      <a class="home" href={`${base}/`}>
        <b>Cores</b>
        <span>Design system</span>
      </a>
      <nav class="toc">
        {
          nav.map((g) => (
            <div class="group">
              <p class="group-label">{g.group}</p>
              <ol>
                {g.items.map((i) => (
                  <li>
                    <a href={`#${i.id}`} data-spy={i.id}>
                      <span class="num">{i.num}</span>
                      {i.label}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </nav>
      <a class="cta" href={`${base}/`}>Browse the palettes</a>
    </aside>

    <main class="doc">
      <!-- Overview ---------------------------------------------------------->
      <header class="hero" id="overview" data-section>
        <p class="eyebrow"><i></i>Cores design system</p>
        <h1>The palette leads. The interface steps back.</h1>
        <p class="lede">
          The rules behind Cores: the mark, the five gray tokens, the type scale and the small set of controls that
          frame {infos.length} palettes without competing with them.
        </p>
        <dl class="stats">
          <div><dt>Collection</dt><dd>{infos.length} palettes, {brandCount} brand systems</dd></div>
          <div><dt>Colors</dt><dd>{allHexes.length} unique values</dd></div>
          <div><dt>Type</dt><dd>Schibsted Grotesk, four weights</dd></div>
          <div><dt>Interface</dt><dd>5 tokens, light and dark</dd></div>
        </dl>

        <ol class="principles">
          <li>
            <span class="num">01</span>
            <h3>Gray holds the frame</h3>
            <p>The chrome is warm gray only, so every palette reads true and no UI color is mistaken for part of it.</p>
          </li>
          <li>
            <span class="num">02</span>
            <h3>Every value copies</h3>
            <p>A swatch is a button. Click it and the hex lands on the clipboard, confirmed by a toast in that color.</p>
          </li>
          <li>
            <span class="num">03</span>
            <h3>Ink picks itself</h3>
            <p>Text on a swatch is black or white, whichever has more contrast. Nobody picks it by eye.</p>
          </li>
        </ol>
      </header>

      <!-- Logo -------------------------------------------------------------->
      <section id="logo" data-section>
        <div class="sec-head">
          <span class="num">{num.logo}</span>
          <div>
            <h2>Logo</h2>
            <p>
              Twelve nested chevron bands on a squircle, under an outlined wordmark. The mark has no fixed colors: it
              wears whichever palette it sits beside.
            </p>
          </div>
        </div>

        <div class="logo-stage">
          <Logo class="logo-live" />
          <p class="note">
            Live: the home page mark starts in monochrome, then walks through every palette in the collection and links
            to the one on show.
          </p>
        </div>

        <h3 class="sub">Dressed in a palette</h3>
        <div class="logo-grid">
          {
            logoSamples.map((s) => (
              <figure>
                <svg viewBox={`0 0 ${SIZE} ${SIZE}`} role="img" aria-label={`Cores logo in ${s.title}`}>
                  <defs>
                    <clipPath id={s.clip}>
                      <path d={SHAPE} />
                    </clipPath>
                  </defs>
                  <g clip-path={`url(#${s.clip})`}>
                    <rect width={SIZE} height={SIZE} fill={s.fills[0]} />
                    {BANDS.map((pts, i) => (
                      <polygon points={pts} fill={s.fills[i + 1]} />
                    ))}
                  </g>
                  <path d={WORDMARK} fill={s.fills[s.fills.length - 1]} />
                </svg>
                <figcaption>
                  {s.url ? <a href={s.url}>{s.title}</a> : s.title}
                  <span class="ramp">
                    {s.fills.map((f) => (
                      <i style={`--c:${f}`} />
                    ))}
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>

        <ol class="rules">
          <li><b>Ground</b> The palette's most colorful value that still carries white text at 5:1 or better.</li>
          <li><b>Bands</b> Walk from the ground to the lightest color in OKLab, in lightness steps that start slow.</li>
          <li><b>Wordmark</b> The lightest color when it reads on the ground, otherwise white.</li>
        </ol>
      </section>

      <!-- Color ------------------------------------------------------------->
      <section id="color" data-section>
        <div class="sec-head">
          <span class="num">{num.color}</span>
          <div>
            <h2>Color</h2>
            <p>
              Five interface tokens, each with a light and a dark value that follow the system setting. Click any value
              to copy it.
            </p>
          </div>
        </div>

        <h3 class="sub">Interface tokens</h3>
        <div class="tokens">
          {
            colorTokens.map((t) => (
              <article class="token">
                <div class="token-name">
                  <button
                    type="button"
                    class="code-chip"
                    data-copy={`var(--${t.name})`}
                    aria-label={`Copy var(--${t.name})`}
                  >
                    --{t.name}
                  </button>
                  <p>{t.use}</p>
                </div>
                <div class="modes">
                  {[
                    ['Light', t.light],
                    ['Dark', t.dark],
                  ].map(([mode, hex]) => (
                    <button
                      type="button"
                      class="mode"
                      data-copy={hex}
                      data-swatch={hex}
                      aria-label={`Copy ${mode.toLowerCase()} ${t.name}, ${hex}`}
                    >
                      <i style={`--c:${hex}`} />
                      <span>
                        <small>{mode}</small>
                        <span class="hex">{hex}</span>
                      </span>
                    </button>
                  ))}
                </div>
              </article>
            ))
          }
        </div>

        <h3 class="sub">Hue families</h3>
        <p class="sub-lede">
          Every color in the collection falls into one of {hueRows.length} families by OKLCH hue. They drive the hue
          filter on the home page.
        </p>
        <div class="hues-grid">
          {
            hueRows.map((h) => (
              <button
                type="button"
                class="hue-card"
                data-copy={h.swatch}
                data-swatch={h.swatch}
                data-label={`${h.hue}, ${h.swatch}`}
                style={`--c:${h.swatch};--on:${inkOn(h.swatch)}`}
              >
                <span class="hue-fill">
                  <span class="hex">{h.swatch}</span>
                </span>
                <span class="hue-meta">
                  <b>{h.hue}</b>
                  <span>
                    {h.colors} colors · {h.palettes} palettes
                  </span>
                </span>
              </button>
            ))
          }
        </div>

        <h3 class="sub">Roles</h3>
        <p class="sub-lede">
          Palettes carry no fixed roles. Cores assigns them from contrast and chroma, shown here on <a
            href={href(sample.palette.id)}>{sample.palette.data.title}</a
          >.
        </p>
        <div class="roles">
          <div class="role-set">
            <p class="role-title">In-use preview <code>assignRoles()</code></p>
            {
              uiRoles.map(([role, hex, why]) => (
                <button type="button" class="role" data-copy={hex} data-swatch={hex} data-label={`${role}, ${hex}`}>
                  <i style={`--c:${hex}`} />
                  <span class="role-name">{role}</span>
                  <span class="role-why">{why}</span>
                  <span class="hex">{hex}</span>
                </button>
              ))
            }
          </div>
          <div class="role-set">
            <p class="role-title">Brand studio <code>brandRoles()</code></p>
            <div class="role-strip">
              {
                brandRoleRows.map(([role, hex]) => (
                  <button
                    type="button"
                    style={`--c:${hex};--on:${inkOn(hex)}`}
                    data-copy={hex}
                    data-swatch={hex}
                    data-label={`${role}, ${hex}`}
                  >
                    <span>{role}</span>
                    <span class="hex">{hex}</span>
                  </button>
                ))
              }
            </div>
            <div
              class="mini"
              style={`--p:${brand.paper};--t:${brand.text};--a:${brand.primary};--s:${brand.surface}`}
              aria-hidden="true"
            >
              <span class="mini-kicker">Roles in use</span>
              <b>{sample.palette.data.title}</b>
              <span class="mini-btn">Primary</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Typography -------------------------------------------------------->
      <section id="type" data-section>
        <div class="sec-head">
          <span class="num">{num.type}</span>
          <div>
            <h2>Typography</h2>
            <p>
              Schibsted Grotesk throughout, on a 1.25 scale from a 16px base. IBM Plex Mono appears only where values
              are printed as specimens.
            </p>
          </div>
        </div>

        <div class="specimen">
          <p class="display">Aa</p>
          <div>
            <p class="family">Schibsted Grotesk</p>
            <div class="weights">
              <span style="font-weight:400">400 Regular</span>
              <span style="font-weight:500">500 Medium</span>
              <span style="font-weight:700">700 Bold</span>
              <span style="font-weight:800">800 Extra bold</span>
            </div>
            <p class="mono-line">IBM Plex Mono 400 / 600 · {light.ink.toUpperCase()} · {formatOklch(light.ink.toUpperCase())}</p>
          </div>
        </div>

        <h3 class="sub">Display</h3>
        <div class="type-row display-row">
          <div class="type-meta">
            <b>Page title</b>
            <span>clamp(2.5rem, 7vw, 5.5rem) · 800 · −0.045em · 0.92</span>
          </div>
          <p class="t-display">Golden hour</p>
        </div>

        <h3 class="sub">Scale</h3>
        {
          typeSteps.map((s) => (
            <div class="type-row">
              <div class="type-meta">
                <button type="button" class="code-chip" data-copy={`var(--${s.token})`}>
                  --{s.token}
                </button>
                <span>
                  {s.size} · {s.role}
                </span>
              </div>
              <p style={`font-size:var(--${s.token});font-weight:${s.token === 'step-3' || s.token === 'step-2' ? 700 : s.token === 'step-1' ? 500 : 400}`}>
                {s.sample}
              </p>
            </div>
          ))
        }

        <ul class="facts-list">
          <li><b>Headings</b> 700, line height 1.1, tracking −0.02em, balanced wrap.</li>
          <li><b>Body</b> 400, line height 1.5, pretty wrap.</li>
          <li><b>Values</b> Hex codes use tabular figures so columns line up.</li>
        </ul>
      </section>

      <!-- Layout ------------------------------------------------------------>
      <section id="layout" data-section>
        <div class="sec-head">
          <span class="num">{num.layout}</span>
          <div>
            <h2>Layout</h2>
            <p>A fluid gutter, a wide cap and a card grid that fills whatever width it gets.</p>
          </div>
        </div>

        <div class="layout-grid">
          <article class="spec">
            <button type="button" class="code-chip" data-copy="var(--gutter)">--gutter</button>
            <p class="spec-value">{light.gutter}</p>
            <div class="gutter-demo" aria-hidden="true"><span></span><span></span></div>
            <p>Side padding. 16px on a phone, up to 40px on a wide screen.</p>
          </article>
          <article class="spec">
            <button type="button" class="code-chip" data-copy="var(--max)">--max</button>
            <p class="spec-value">{light.max}</p>
            <div class="max-demo" aria-hidden="true"><span></span></div>
            <p>The <code>.wrap</code> container caps here and centers.</p>
          </article>
          <article class="spec">
            <span class="code-chip static">.grid</span>
            <p class="spec-value">minmax(15.5rem, 1fr)</p>
            <div class="grid-demo" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            <p>Palette cards auto-fill. Gaps are 2rem down, 1 to 1.75rem across.</p>
          </article>
        </div>

        <h3 class="sub">Radius</h3>
        <div class="radii">
          {
            [
              ['4px', 'Chips on the stage'],
              ['6px', 'Cards, fields, code blocks, buttons'],
              ['999px', 'Pills: hue filters, tags, tabs, toast'],
              ['50%', 'Dots: hue swatches, toast swatch'],
            ].map(([r, use]) => (
              <div class="radius">
                <span class="radius-box" style={`border-radius:${r}`} />
                <b>{r}</b>
                <span>{use}</span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Motion ------------------------------------------------------------>
      <section id="motion" data-section>
        <div class="sec-head">
          <span class="num">{num.motion}</span>
          <div>
            <h2>Motion</h2>
            <p>
              Short, eased and only where something changes size or color. Everything drops to near zero under reduced
              motion. Hover or focus a row to play it.
            </p>
          </div>
        </div>

        <div class="motion-list">
          {
            [
              ['Settle', 'cubic-bezier(0.2, 0.8, 0.2, 1)', '220ms', 'A card chip widening on hover; chips rising on load (700ms).'],
              ['Glide', 'cubic-bezier(0.7, 0, 0.2, 1)', '750ms', 'The home stage sliding to the next palette.'],
              ['Fade', 'cubic-bezier(0.4, 0, 0.2, 1)', '900ms', 'The logo changing palette, band by band 45ms apart.'],
              ['Toast', 'ease', '160ms', 'The copy toast fading and lifting in.'],
            ].map(([name, curve, dur, use]) => (
              <button type="button" class="motion" style={`--ease:${curve};--dur:${dur}`} data-copy={`${dur} ${curve}`}>
                <span class="motion-name">
                  <b>{name}</b>
                  <span class="hex">
                    {dur} · {curve}
                  </span>
                </span>
                <span class="track" aria-hidden="true">
                  <span class="dot" />
                </span>
                <span class="motion-use">{use}</span>
              </button>
            ))
          }
        </div>
      </section>

      <!-- Swatches ---------------------------------------------------------->
      <section id="swatches" data-section>
        <div class="sec-head">
          <span class="num">{num.swatches}</span>
          <div>
            <h2>Swatches</h2>
            <p>
              The core component. A palette card is a row of chips that copy on click, with the title linking to the
              palette page.
            </p>
          </div>
        </div>

        <div class="preview">
          <div class="preview-bar"><span>PaletteCard</span><span>src/components/PaletteCard.astro</span></div>
          <div class="preview-body cards">
            {cardSamples.map((info, i) => <PaletteCard info={info} order={i} />)}
          </div>
        </div>
        <ul class="facts-list">
          <li><b>Hover</b> The chip under the pointer grows 2.6× and shows its hex.</li>
          <li><b>Touch</b> Hex labels stay visible since there is no hover.</li>
          <li><b>Frame</b> 6px radius and a 1px inset rule so pale chips don't melt into the page.</li>
        </ul>

        <h3 class="sub">Stage chip</h3>
        <div class="preview">
          <div class="preview-bar"><span>Chip</span><span>Home page stage</span></div>
          <div class="preview-body chip-row">
            {
              sample.palette.data.colors.map((c, i) => (
                <span
                  class:list={['stage-chip', { open: i === 1 }]}
                  style={`--c:${c.hex};--on:${inkOn(c.hex)}`}
                >
                  {i === 1 ? (
                    <>
                      <b>{c.name ?? c.role ?? 'Color'}</b>
                      <span class="hex">{c.hex}</span>
                    </>
                  ) : (
                    <b>{Math.round(oklch(c.hex).l * 100)}</b>
                  )}
                </span>
              ))
            }
          </div>
        </div>
        <p class="note">Closed chips show OKLCH lightness. The open chip shows the name and hex.</p>
      </section>

      <!-- Controls ---------------------------------------------------------->
      <section id="controls" data-section>
        <div class="sec-head">
          <span class="num">{num.controls}</span>
          <div>
            <h2>Controls</h2>
            <p>Few and quiet. Pressed state is an ink border on a raised fill, never an accent color.</p>
          </div>
        </div>

        <div class="comp-grid">
          <div class="preview">
            <div class="preview-bar"><span>Button</span></div>
            <div class="preview-body center">
              <button type="button" class="btn">Clear filters</button>
              <button type="button" class="btn-pill">Copy</button>
