    gap: 0.1rem;
    border-right: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .win-side li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: var(--r-sm);
  }

  .win-side i {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 3px;
    background: var(--line);
  }

  .win-side .on {
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
  }

  .win-side .on i {
    background: var(--on-accent);
    opacity: 0.6;
  }

  .win-main {
    display: grid;
    gap: 0.7rem;
    padding: 0.85rem;
  }

  .win-greet {
    font-size: 1.2rem;
    line-height: 1.1;
  }

  .win-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
  }

  .win-stat {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem;
    border-radius: var(--r-sm);
    background: var(--surface);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .win-stat b {
    font-family: var(--head);
    font-size: 1.15rem;
    letter-spacing: var(--track);
    color: var(--text);
  }

  .win-stat.two {
    background: var(--accent2);
    color: var(--on-accent2);
  }

  .win-stat.two b {
    color: inherit;
  }

  .meter {
    display: block;
    height: 0.35rem;
    margin-top: 0.2rem;
    border-radius: 99px;
    background: var(--line);
    overflow: hidden;
  }

  .meter i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
  }

  .win-chart {
    display: flex;
    align-items: end;
    gap: 0.3rem;
    height: 4rem;
  }

  .win-chart i {
    flex: 1;
    border-radius: 3px 3px 1px 1px;
    background: var(--accent);
  }

  .win-chart .b1 {
    background: var(--accent2);
  }

  .win-chart .b2 {
    background: var(--surface);
  }

  .dock {
    position: relative;
    display: flex;
    gap: 0.4rem;
    padding: 0.4rem;
    border-radius: calc(var(--r-md) + 0.4rem);
    background: color-mix(in oklab, var(--bg) 70%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 0 0 1px var(--line);
  }

  .dock i {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-md);
    background: var(--accent);
  }

  .dock i:nth-child(2) { background: var(--accent2); }
  .dock i:nth-child(3) { background: var(--text); }
  .dock i:nth-child(4) { background: var(--surface); }
  .dock i:nth-child(5) { background: var(--muted); }
  .dock i:nth-child(6) { background: linear-gradient(135deg in oklab, var(--accent), var(--accent2)); }

  /* Interface column */
  .kit {
    display: grid;
    align-content: start;
    font-size: 0.875rem;
  }

  .kit-copy,
  .kit-block {
    display: grid;
    gap: 0.85rem;
    padding: var(--pad);
  }

  .kit-block {
    border-top: 1px solid var(--line);
  }

  .kit-title {
    font-size: clamp(1.75rem, 3vw, 2.6rem);
    line-height: 1;
    text-wrap: balance;
    outline: none;
    border-radius: 4px;
  }

  .kit-title:focus-visible {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .kit-lede {
    max-width: 38ch;
    color: var(--muted);
    font-size: 1rem;
  }

  .kit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .kit-row.between {
    justify-content: space-between;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.7rem 1.15rem;
    border-radius: var(--r-md);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.1;
    white-space: nowrap;
  }

  .btn.small {
    padding: 0.5rem 0.85rem;
    border-radius: var(--r-sm);
    font-size: 0.8125rem;
  }

  .btn.alt {
    background: var(--surface);
    color: var(--text);
  }

  .field-mock {
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--r-sm);
    box-shadow: inset 0 0 0 1.5px var(--accent);
  }

  .field-mock span {
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .field-mock b {
    font-weight: 500;
  }

  .toggle {
    display: inline-flex;
    justify-content: end;
    width: 2.4rem;
    height: 1.4rem;
    padding: 0.15rem;
    border-radius: 99px;
    background: var(--accent);
  }

  .toggle i {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--on-accent);
  }

  .toggle.off {
    justify-content: start;
    background: var(--surface);
  }

  .toggle.off i {
    background: var(--bg);
    box-shadow: 0 1px 2px color-mix(in oklab, var(--text) 25%, transparent);
  }

  .seg-mock {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 0.2rem;
    border-radius: var(--r-sm);
    background: var(--surface);
    font-size: 0.8125rem;
    text-align: center;
  }

  .seg-mock span {
    padding: 0.3rem;
    border-radius: calc(var(--r-sm) * 0.7);
    color: var(--muted);
  }

  .seg-mock .on {
    background: var(--bg);
    color: var(--text);
    font-weight: 600;
  }

  /* Phone */
  .phone-tile {
    display: grid;
    place-items: center;
    padding: var(--pad) 0;
    background: var(--accent);
  }

  .phone {
    width: min(78%, 15rem);
    aspect-ratio: 9 / 18.5;
    padding: 0.45rem;
    border-radius: 2.1rem;
    background: var(--text);
    rotate: -7deg;
    box-shadow: 0 30px 50px -20px color-mix(in oklab, var(--text) 60%, transparent);
  }

  .screen {
    height: 100%;
    display: grid;
    grid-template-rows: auto auto 1fr auto auto auto auto;
    gap: 0.6rem;
    padding: 1.6rem 0.85rem 0.75rem;
    overflow: hidden;
    border-radius: 1.7rem;
    background: var(--bg);
    font-size: 0.6875rem;
  }

  .ph-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ph-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .ph-logo .mark {
    width: 0.9rem;
    height: 0.9rem;
  }

  .ph-logo b {
    font-size: 0.8125rem;
  }

  .ph-menu {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--text);
  }

  .ph-title {
    font-size: 1.45rem;
    line-height: 0.95;
  }

  .ph-art {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--surface);
  }

  .ph-art i {
    position: absolute;
    border-radius: 50%;
  }

  .ph-art i:nth-child(1) {
    width: 80%;
    aspect-ratio: 1;
    right: -25%;
    top: -30%;
    background: var(--accent);
  }

  .ph-art i:nth-child(2) {
    width: 45%;
    aspect-ratio: 1;
    left: 8%;
    bottom: -20%;
    background: var(--accent2);
  }

  .ph-art i:nth-child(3) {
    width: 30%;
    height: 14%;
    left: 10%;
    top: 14%;
    border-radius: 99px;
    background: var(--text);
  }

  .ph-chips {
    display: flex;
    gap: 0.3rem;
  }

  .ph-chips span {
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .ph-chips .on {
    background: var(--text);
    color: var(--bg);
    box-shadow: none;
  }

  .ph-row {
    display: flex;
    justify-content: space-between;
    padding: 0.45rem 0.55rem;
    border-radius: var(--r-sm);
    background: var(--surface);
  }

  .ph-tabs {
    display: flex;
    justify-content: space-around;
    padding-top: 0.35rem;
  }

  .ph-tabs i {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 4px;
    background: var(--line);
  }

  .ph-tabs .on {
    background: var(--accent);
  }

  /* Stat bubble */
  .stat {
    display: grid;
    place-items: center;
    min-height: 15rem;
    padding: var(--pad);
    background: var(--accent2);
  }

  .stat-disc {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    width: min(100%, 13rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--bg);
    text-align: center;
  }

  .stat-badge {
    position: absolute;
    top: 4%;
    left: 4%;
    display: grid;
    place-items: center;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--text);
    color: var(--accent2);
  }

  .stat-badge svg {
    width: 50%;
    fill: currentColor;
  }

  .stat-num {
    display: flex;
    align-items: center;
    gap: 0.1em;
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    line-height: 1;
  }

  .stat-num svg {
    width: 0.7em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
  }

  .stat-label {
    max-width: 11ch;
    margin-top: 0.3rem !important;
    font-size: 0.875rem;
    line-height: 1.25;
  }

  /* Icon set */
  .icon-set {
    display: grid;
    grid-template-columns: repeat(2, auto);
    place-content: center;
    gap: 0.6rem;
    min-height: 15rem;
    padding: var(--pad);
  }

  .ic {
    display: grid;
    place-items: center;
    width: clamp(3.5rem, 6vw, 4.75rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--text);
    color: var(--bg);
  }

  .ic:nth-child(2) {
    color: var(--accent2);
  }

  .ic:nth-child(4) {
    background: var(--accent);
    color: var(--on-accent);
  }

  .ic svg {
    width: 44%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Value pills */
  .pills {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: 0.45rem;
    padding: var(--pad);
    background: var(--surface);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    height: 2.6rem;
    padding: 0 1rem;
    border-radius: 99px;
    background: var(--bg);
    font-size: 1.15rem;
    line-height: 1;
  }

  .pill.dot {
    width: 2.6rem;
    padding: 0;
    background: radial-gradient(circle, var(--accent2) 0 22%, transparent 23%) 0 0 / 0.65rem 0.65rem, var(--accent);
  }

  .pill.dot.alt {
    background: repeating-linear-gradient(45deg, var(--text) 0 3px, var(--bg) 3px 6px);
  }

  .pill.grad {
    background: linear-gradient(90deg in oklab, var(--text), var(--accent));
    color: var(--bg);
  }

  .pill.outline {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--text);
  }

  /* Chat */
  .chat {
    display: grid;
    align-content: center;
    gap: 1.1rem;
    padding: var(--pad);
    background: var(--surface);
  }

  .bubble {
    position: relative;
    justify-self: start;
    max-width: 85%;
    padding: 0.75rem 1.1rem;
    border-radius: 1.4rem;
    background: var(--accent2);
    color: var(--on-accent2);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.1;
    box-shadow: 0 0 0 2px var(--text);
  }

  .bubble::after {
    content: '';
    position: absolute;
    left: 1.25rem;
    bottom: -0.55rem;
    width: 1rem;
    height: 1rem;
    background: inherit;
    clip-path: polygon(0 0, 100% 0, 0 100%);
    box-shadow: inherit;
  }

  .bubble.two {
    justify-self: end;
    background: var(--bg);
    color: var(--text);
  }

  .bubble.two::after {
    left: auto;
    right: 1.25rem;
    clip-path: polygon(0 0, 100% 0, 100% 100%);
  }

  /* Billboard */
  .street {
    display: grid;
    place-items: center;
    min-height: 22rem;
    padding: var(--pad) var(--pad) 0;
    background:
      linear-gradient(transparent 78%, color-mix(in oklab, var(--text) 18%, var(--surface)) 78%),
      linear-gradient(var(--bg), var(--surface));
  }

  .board {
    width: min(100%, 44rem);
    display: grid;
    justify-items: center;
  }

  .board-lights {
    display: flex;
    justify-content: space-around;
    width: 90%;
  }

  .board-lights i {
    width: 1.6rem;
    height: 0.5rem;
    border-radius: 2px 2px 0 0;
    background: var(--muted);
  }

  .board-face {
    width: 100%;
    aspect-ratio: 3.2;
    display: grid;
    grid-template-columns: 1fr 1fr 1.5fr;
    overflow: hidden;
    border: 0.45rem solid var(--text);
    border-radius: 4px;
    background: var(--bg);
  }

  .bf-a {
    display: grid;
    place-items: center;
    background: var(--accent);
    --m1: var(--on-accent);
  }

  .bf-a .mark {
    width: 55%;
    height: auto;
    aspect-ratio: 1;
  }

  .bf-b {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.25rem;
    padding: 0.7rem;
    font-size: clamp(0.5rem, 0.9vw, 0.6875rem);
  }

  .bf-b span {
    padding: 0.1rem 0.45rem;
    border-radius: 99px;
    box-shadow: inset 0 0 0 1px var(--text);
  }

  .bf-b b {
    margin-top: auto;
    align-self: end;
    font-size: clamp(0.9rem, 1.6vw, 1.25rem);
  }

  .bf-c {
    display: grid;
    align-content: space-between;
    padding: 0.7rem;
    background: var(--accent2);
    color: var(--on-accent2);
  }

  .bf-c b {
    font-size: clamp(1.1rem, 2.6vw, 2.1rem);
    line-height: 0.95;
  }

  .bf-c span {
    font-size: clamp(0.5rem, 0.9vw, 0.6875rem);
  }

  .board-legs {
    display: flex;
    justify-content: space-between;
    width: 40%;
  }

  .board-legs i {
    width: 0.6rem;
    height: clamp(3rem, 6vw, 4.5rem);
    background: var(--text);
  }

  /* ID badge */
  .badge-tile {
    display: grid;
    justify-items: center;
    align-content: start;
    min-height: 22rem;
    background: var(--accent);
  }

  .strap {
    width: 1.1rem;
    height: 3.5rem;
    background: var(--text);
  }

  .badge {
    width: min(72%, 14rem);
    margin-top: -0.3rem;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--bg);
    rotate: 6deg;
    transform-origin: top center;
    box-shadow: 0 24px 40px -18px color-mix(in oklab, var(--text) 60%, transparent);
  }

  .badge-top {
    position: relative;
    display: grid;
    align-items: end;
    aspect-ratio: 1.15;
    padding: 1rem;
    background: var(--accent2);
    --m1: var(--text);
    --m2: var(--bg);
  }

  .badge-top .mark {
    width: 42%;
    height: auto;
    aspect-ratio: 1;
  }

  .qr {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    width: 2.4rem;
    aspect-ratio: 1;
  }

  .qr i.on {
    background: var(--text);
  }

  .badge-name {
    display: grid;
    padding: 0.8rem 1rem 1rem;
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .badge-name b {
    font-size: 1.2rem;
    line-height: 1.1;
    color: var(--text);
  }

  /* Type */
  .specimen {
    display: grid;
    align-content: space-between;
    gap: 1.5rem;
    padding: var(--pad);
    background: var(--accent);
    color: var(--on-accent);
  }

  .specimen-aa {
    font-size: clamp(6rem, 13vw, 11rem);
    line-height: 0.8;
  }

  .specimen-glyphs {
    font-size: clamp(1.05rem, 1.7vw, 1.4rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .specimen-name {
    font-size: 0.8125rem;
  }

  .specimen-name span {
    margin-left: 0.3rem;
    opacity: 0.7;
  }

  .scale {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: var(--pad);
  }

  .scale p {
    overflow-wrap: anywhere;
  }

  .s-1 {
    font-size: clamp(2.75rem, 6vw, 5rem);
    line-height: 0.9;
  }

  .s-2 {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.05;
  }

  .s-3 {
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--muted);
  }

  .s-body {
    max-width: 56ch;
    line-height: 1.6;
  }

  .scale .specimen-name {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }

  .scale .specimen-name span {
    color: var(--muted);
    opacity: 1;
  }

  /* In use: layout columns behind the content, with each style called out on the left */
  .inuse {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding: clamp(1.5rem, 4vw, 3rem) var(--pad);
  }

  .cols {
    position: absolute;
    inset: 0 var(--pad) 0 calc(var(--pad) + 9rem);
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 1rem;
    pointer-events: none;
  }

  .cols i {
    background: color-mix(in oklab, var(--accent2) 16%, transparent);
  }

  .iu-row {
    position: relative;
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    align-items: center;
  }

  .iu-row > :last-child {
    justify-self: start;
  }

  .iu-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-right: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .iu-note::after {
    content: '';
    flex: 1;
    border-top: 1px dashed var(--muted);
  }

  .iu-h {
    max-width: 18ch;
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    line-height: 1;
  }

  .iu-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 2rem;
    max-width: 44rem;
    font-size: 0.9375rem;
  }

  .iu-cols b {
    display: block;
    margin-bottom: 0.2rem;
  }

  /* Posters */
  .poster {
    container-type: inline-size;
    aspect-ratio: 4 / 5;
    display: grid;
    align-content: space-between;
    padding: clamp(0.9rem, 1.8vw, 1.4rem);
  }

  .poster-top {
    position: relative;
    font-size: max(0.75rem, 4.5cqi);
    font-weight: 600;
  }

  .poster b {
    position: relative;
    font-size: 21cqi;
    line-height: 0.88;
    overflow-wrap: anywhere;
  }

  .poster.one {
    background: var(--accent2);
    color: var(--on-accent2);
  }

  .poster.one b {
    font-size: 125cqi;
    line-height: 0.72;
    margin: 0 0 -9cqi -6cqi;
  }

  .poster.two {
    background: var(--text);
    color: var(--bg);
  }

  .poster.two b {
    font-size: 15cqi;
    max-width: 8ch;
  }

  .poster.two .dot {
    position: absolute;
    right: -14cqi;
    top: 14cqi;
    width: 64cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
  }

  .poster.two .pill-shape {
    position: absolute;
    left: clamp(0.9rem, 1.8vw, 1.4rem);
    top: 48cqi;
    width: 46cqi;
    height: 14cqi;
    border-radius: 99px;
    background: var(--accent2);
  }

  .poster.three {
    background: var(--surface);
  }

  .poster.three b {
    font-size: 16cqi;
  }

  .icons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4cqi;
    width: 70%;
  }

  .icons i {
    aspect-ratio: 1;
    border-radius: min(var(--r-md), 6cqi);
    background: var(--accent);
  }

