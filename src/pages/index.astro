---
import Base from '../layouts/Base.astro';
import PaletteCard from '../components/PaletteCard.astro';
import { HUES, contrast, hueFamily, inkOn, oklch } from '../lib/color';
import { getPalettes, href } from '../lib/palettes';

const infos = await getPalettes();
const allHexes = [...new Set(infos.flatMap(({ palette }) => palette.data.colors.map((c) => c.hex)))];

// Every palette as a light-to-dark ramp of chips, walked around the hue wheel.
const ramps = [...infos]
  .sort((a, b) => a.leadHue - b.leadHue)
  .map(({ palette, lead }) => {
    const colors = [...new Map(palette.data.colors.map((c) => [c.hex, c])).values()]
      .map((c) => ({ ...c, l: oklch(c.hex).l }))
      .sort((a, b) => b.l - a.l);
    const ratio = contrast(colors[0].hex, colors[colors.length - 1].hex);
    return {
      title: palette.data.title,
      url: href(palette.id),
      accent: lead,
      contrast: `${ratio >= 10 ? Math.round(ratio) : ratio.toFixed(1)}:1`,
      colors,
    };
  });
const start = Math.floor(ramps.length / 2);

const tagCounts = new Map<string, number>();
for (const { palette } of infos)
  for (const t of palette.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const hueNames = new Set<string>([...HUES, 'brand']);
const topTags = [...tagCounts]
  .filter(([t, n]) => n > 1 && !hueNames.has(t))
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12)
  .map(([t]) => t);

const hueSwatch: Record<string, string> = {};
for (const h of HUES) {
  // Most saturated mid-light color of the family, so the dot reads as the hue.
  const score = (hex: string) => {
    const { l, c } = oklch(hex);
    return h === 'neutral' ? -Math.abs(l - 0.75) : c - Math.abs(l - 0.65) * 0.3;
  };
  const hit = allHexes.filter((hex) => hueFamily(hex) === h).sort((a, b) => score(b) - score(a));
  hueSwatch[h] = hit[0] ?? '#888888';
}
const huesPresent = HUES.filter((h) => infos.some((i) => i.hues.includes(h)));
const hasBrand = infos.some((i) => i.palette.data.origin === 'brand');
---

<Base title="Cores">
  <header class="wrap masthead">
    <h1>Cores</h1>
    <nav class="links">
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/today/`}>Color of the day</a>
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/brand/`}>Brand lab</a>
    </nav>
  </header>

  <section aria-label="Every palette in the collection, ordered by hue">
    <div class="stage" id="stage" aria-hidden="true">
      <div class="row">
        {
          ramps.map((r, i) => (
            <a
              class="ramp"
              href={r.url}
              tabindex="-1"
              style={`--accent:${r.accent}`}
              data-title={r.title}
              data-contrast={r.contrast}
            >
              {r.colors.map((c, j) => (
                <span
                  class:list={['chip', { on: i === start && j === Math.floor(r.colors.length / 2) }]}
                  style={`--c:${c.hex};--on:${inkOn(c.hex)};--d:${Math.min(Math.abs(i - start), 14) * 40 + j * 15}ms`}
                >
                  <b class="l">{Math.round(c.l * 100)}</b>
                  <span class="name">{c.name ?? c.role}</span>
                  <span class="hex">{c.hex}</span>
                </span>
              ))}
            </a>
          ))
        }
      </div>
      <div class="bracket" style={`--accent:${ramps[start].accent}`}>
        <span><b>{ramps[start].title}</b> Contrast {ramps[start].contrast}</span>
      </div>
    </div>
    <noscript><style>.stage .row { opacity: 1 !important; }</style></noscript>
  </section>

  <main class="wrap">
    <form class="filters" id="filters" role="search" onsubmit="return false">
      <label class="search">
        <span class="visually-hidden">Search palettes</span>
        <input type="search" name="q" placeholder="Search by name, color or hex" autocomplete="off" />
      </label>

      <fieldset class="hues">
        <legend class="visually-hidden">Filter by hue</legend>
        {
          huesPresent.map((h) => (
            <button type="button" class="hue" data-hue={h} aria-pressed="false" title={h}>
              <i style={`--c:${hueSwatch[h]}`} />
              <span>{h}</span>
            </button>
          ))
        }
      </fieldset>

      <label class="sort">
        <span>Sort</span>
        <select name="sort">
          <option value="hue">By hue</option>
          <option value="order">A to Z</option>
          <option value="light">Lightest first</option>
          <option value="dark">Darkest first</option>
        </select>
      </label>

      <fieldset class="tags">
        <legend class="visually-hidden">Filter by mood</legend>
        {
          hasBrand && (
            <button type="button" class="tag" data-origin="brand" aria-pressed="false">
              brand systems
            </button>
          )
        }
        {
          topTags.map((t) => (
            <button type="button" class="tag" data-tag={t} aria-pressed="false">
              {t}
            </button>
          ))
        }
      </fieldset>
    </form>

    <p class="status" id="status" aria-live="polite"></p>

    <div class="grid" id="grid">
      {infos.map((info, i) => <PaletteCard info={info} order={i} />)}
    </div>

    <div class="empty" id="empty" hidden>
      <p>No palettes match these filters.</p>
      <button type="button" id="clear">Clear filters</button>
    </div>
  </main>

  <footer class="wrap foot">
    <p>
      Colors were transcribed from the hex codes printed on each source image, or sampled from the pixels where none
      were printed. Palette credits stay with their original creators.
    </p>
  </footer>
</Base>

<script>
  // Ramp stage: one chip at a time opens into a labeled tile while the row glides to center it.
  const stage = document.getElementById('stage')!;
  const row = stage.querySelector<HTMLElement>('.row')!;
  const bracket = stage.querySelector<HTMLElement>('.bracket')!;
  const caption = bracket.querySelector('span')!;
  const chips = [...row.querySelectorAll<HTMLElement>('.chip')];
  const indexOf = new Map(chips.map((c, i) => [c, i]));
  // Index of the first chip in each chip's ramp.
  const firstOf = chips.map((c) => indexOf.get(c.parentElement!.firstElementChild as HTMLElement)!);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let current = Math.max(0, chips.findIndex((c) => c.classList.contains('on')));
  let tx = 0;
  // Settled geometry with every chip closed, plus how much one chip grows when it opens.
  let lefts: number[] = [];
  let size = 0;
  let growth = 0;
  let rowWidth = 0;
  let stageWidth = 0;

  const rampOf = (i: number) => chips[i].parentElement!;

  function centered(i: number) {
    const x = stageWidth / 2 - (lefts[i] + (size + growth) / 2);
    return Math.min(0, Math.max(x, stageWidth - rowWidth - growth));
  }

  function feature(i: number, x: number) {
    const ramp = rampOf(i);
    if (i !== current) {
      if (ramp !== rampOf(current)) {
        const { title, contrast } = ramp.dataset;
        caption.innerHTML = '';
        caption.append(Object.assign(document.createElement('b'), { textContent: title }), ` Contrast ${contrast}`);
        if (!reduce) caption.animate({ opacity: [0, 1] }, { duration: 300, delay: 250, fill: 'backwards' });
      }
      chips[current].classList.remove('on');
      chips[i].classList.add('on');
    }
    current = i;
    tx = x;
    const first = firstOf[i];
    const last = first + ramp.childElementCount - 1;
    row.style.transform = `translateX(${x}px)`;
    bracket.style.setProperty('--x', `${lefts[first] + x}px`);
    bracket.style.setProperty('--w', `${lefts[last] - lefts[first] + size + growth}px`);
    bracket.style.setProperty('--accent', ramp.style.getPropertyValue('--accent'));
  }

  function measure() {
    stage.classList.add('measure');
    chips[current].classList.remove('on');
    lefts = chips.map((c) => c.offsetLeft);
    rowWidth = row.offsetWidth;
    stageWidth = stage.clientWidth;
    size = chips[current].offsetWidth;
    chips[current].classList.add('on');
    growth = chips[current].offsetWidth - size;
    feature(current, centered(current));
    void row.offsetWidth;
    stage.classList.remove('measure');
  }

  let timer: number | undefined;
  let hovering = false;
  let inView = true;
  function schedule(delay = 2000) {
    clearTimeout(timer);
    if (reduce || hovering || !inView || document.hidden) return;
    timer = window.setTimeout(() => {
      const next = (current + 1) % chips.length;
      feature(next, centered(next));
      schedule();
    }, delay);
  }

  // Open the chip under the pointer in place, keeping its left edge still so it stays under the cursor,
  // nudged toward the middle when it would open into the faded edges.
  row.addEventListener('pointerover', (e) => {
    if (e.pointerType !== 'mouse') return;
    const c = (e.target as HTMLElement).closest<HTMLElement>('.chip');
    const i = c ? indexOf.get(c)! : -1;
    if (i < 0 || i === current) return;
    const pad = stageWidth * 0.05;
    const anchored = tx + (current < i ? growth : 0);
    const nudged = Math.max(pad - lefts[i], Math.min(anchored, stageWidth - pad - lefts[i] - size - growth));
    // Never nudge the tile out from under the cursor, or the next chip would open and the row would march.
    const px = e.clientX - stage.getBoundingClientRect().left - lefts[i];
    feature(i, Math.min(px - 2, Math.max(nudged, px + 2 - size - growth)));
  });
  stage.addEventListener('pointerenter', (e) => {
    if (e.pointerType !== 'mouse') return;
    hovering = true;
    clearTimeout(timer);
  });
  stage.addEventListener('pointerleave', () => {
    hovering = false;
    schedule(1600);
  });
  document.addEventListener('visibilitychange', () => schedule());
  new IntersectionObserver(([entry]) => {
    inView = entry.isIntersecting;
    schedule();
  }).observe(stage);
  new ResizeObserver(() => {
    if (stage.clientWidth !== stageWidth) measure();
  }).observe(stage);

  measure();
  stage.classList.add('ready');

  // Filtering and sorting
  const form = document.getElementById('filters') as HTMLFormElement;
  const grid = document.getElementById('grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
  const status = document.getElementById('status')!;
  const empty = document.getElementById('empty')!;
  const state = { q: '', hue: '', tag: '', origin: '', sort: 'hue' };

  const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    order: (a, b) => +a.dataset.order! - +b.dataset.order!,
    hue: (a, b) => +a.dataset.hue! - +b.dataset.hue!,
    light: (a, b) => +b.dataset.light! - +a.dataset.light!,
    dark: (a, b) => +a.dataset.light! - +b.dataset.light!,
  };

  function apply() {
    const terms = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const d = card.dataset;
      const ok =
        terms.every((t) => d.search!.includes(t.replace(/^#/, ''))) &&
        (!state.hue || d.hues!.split(' ').includes(state.hue)) &&
        (!state.tag || d.tags!.split(' ').includes(state.tag)) &&
        (!state.origin || d.origin === state.origin);
      card.hidden = !ok;
      if (ok) shown++;
    }
    grid.append(...[...cards].sort(sorters[state.sort]));
    const filtered = state.q || state.hue || state.tag || state.origin;
    status.textContent = filtered ? `Showing ${shown} of ${cards.length} palettes` : '';
    empty.hidden = shown > 0;
  }

  function toggle(group: string, attr: 'hue' | 'tag' | 'origin', btn: HTMLButtonElement) {
    const value = btn.dataset[attr]!;
    const next = state[attr] === value ? '' : value;
    state[attr] = next;
    form.querySelectorAll<HTMLButtonElement>(group).forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset[attr] === next && next !== ''));
    });
  }

  form.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!btn) return;
    if (btn.dataset.hue) toggle('.hue', 'hue', btn);
    else if (btn.dataset.tag) {
      state.origin = '';
      form.querySelector('[data-origin]')?.setAttribute('aria-pressed', 'false');
      toggle('.tag[data-tag]', 'tag', btn);
    } else if (btn.dataset.origin) {
      state.tag = '';
      form.querySelectorAll('[data-tag]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      toggle('[data-origin]', 'origin', btn);
    }
    apply();
  });
  form.q.addEventListener('input', () => {
    state.q = form.q.value.trim();
    apply();
  });
  form.sort.addEventListener('change', () => {
    state.sort = form.sort.value;
    apply();
  });
  apply();

  document.getElementById('clear')!.addEventListener('click', () => {
    Object.assign(state, { q: '', hue: '', tag: '', origin: '' });
    form.q.value = '';
    form.querySelectorAll('[aria-pressed]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
    apply();
  });
</script>

<style>
  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: clamp(2rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .links {
    display: flex;
    gap: 1.25rem;
  }

  .links a {
    font-weight: 500;
    text-underline-offset: 3px;
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 0.82;
    margin-left: -0.04em;
  }



  /* Stage: every palette as a ramp of chips, one chip opened at a time */
  .stage {
    --chip: clamp(1.75rem, 3.2vw, 3.25rem);
    --big: calc(var(--chip) * 2.8);
    --gap: clamp(2px, 0.25vw, 4px);
    --ease: cubic-bezier(0.7, 0, 0.2, 1);
    --dur: 750ms;
    position: relative;
    overflow: hidden;
    padding-block: clamp(1rem, 3vw, 2rem) 3.25rem;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  .row {
    display: flex;
    align-items: flex-end;
    gap: calc(var(--chip) * 0.5);
    width: max-content;
    height: var(--big);
    transition: transform var(--dur) var(--ease);
  }

  .stage:not(.ready) .row {
    opacity: 0;
  }

  .ramp {
    display: flex;
    align-items: flex-end;
    gap: var(--gap);
    text-decoration: none;
  }

  .chip {
    position: relative;
    flex: none;
    width: var(--chip);
    height: var(--chip);
    overflow: hidden;
    container-type: inline-size;
    border-radius: 4px;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
    color: var(--on);
    font-size: clamp(0.625rem, calc(var(--chip) * 0.27), 0.8125rem);
    line-height: 1.2;
    transition:
      width var(--dur) var(--ease),
      height var(--dur) var(--ease);
  }

  .ready .chip {
    transform-origin: bottom;
    animation: rise 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: var(--d);
  }

  .chip.on {
    width: var(--big);
    height: var(--big);
  }

  .chip > * {
    position: absolute;
    left: 0.55em;
    transition: opacity 200ms ease;
  }

  .l,
  .name {
    top: 0.45em;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .name {
    /* Sized to the open tile so the growing chip reveals it instead of rewrapping it. */
    width: calc(var(--big) - 1.1em);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    opacity: 0;
  }

  .hex {
    bottom: 0.5em;
    font-size: 0.85em;
    opacity: 0;
  }

  @container (min-width: 4.5rem) {
    .l {
      opacity: 0;
    }
    .name {
      opacity: 1;
    }
    .hex {
      opacity: 0.7;
    }
  }

  @keyframes rise {
    from {
      transform: scaleY(0);
    }
  }

  .measure,
  .measure * {
    transition: none !important;
  }

  .bracket {
    position: absolute;
    top: calc(100% - 2.6rem);
    left: 0;
    width: var(--w, 0);
    height: 0.6rem;
    border: 1px solid color-mix(in oklab, var(--accent) 45%, var(--rule));
    border-top: 0;
    transform: translateX(var(--x, 0));
    transition:
      transform var(--dur) var(--ease),
      width var(--dur) var(--ease),
      border-color var(--dur) ease;
    pointer-events: none;
  }

  .bracket span {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% -50%;
    padding-inline: 0.6rem;
    background: var(--ground);
    color: var(--muted);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .bracket b {
    color: var(--ink);
    font-weight: 500;
    margin-right: 0.35em;
  }

  /* Filters */
  .filters {
    display: grid;
    grid-template-columns: minmax(12rem, 22rem) 1fr auto;
    grid-template-areas:
      'search hues sort'
      'tags tags tags';
    gap: 0.75rem 1.25rem;
    align-items: center;
    padding-block: 1.25rem 0.5rem;
    border-top: 1px solid var(--rule);
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .search {
    grid-area: search;
  }

  .search input {
    width: 100%;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--raised);
  }

  .search input::placeholder {
    color: var(--muted);
  }

  .hues {
    grid-area: hues;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .hue {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem 0.35rem 0.4rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    font-size: var(--step--1);
    cursor: pointer;
    text-transform: capitalize;
  }

  .hue i {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  .hue:hover {
    border-color: var(--rule);
  }

  .hue[aria-pressed='true'],
  .tag[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--raised);
  }

  .sort {
    grid-area: sort;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .sort select {
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--raised);
    color: var(--ink);
  }

  .tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: none;
    font-size: var(--step--1);
    cursor: pointer;
  }

  .tag:hover {
    border-color: var(--muted);
  }

  @media (max-width: 960px) {
    .filters {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'search sort'
        'hues hues'
        'tags tags';
    }
  }

  @media (max-width: 520px) {
    .filters {
      grid-template-columns: 1fr;
      grid-template-areas: 'search' 'sort' 'hues' 'tags';
    }
    .hue span {
      display: none;
    }
    .hue {
      padding: 0.35rem;
    }
  }

  .status {
    min-height: 1.5rem;
    font-size: var(--step--1);
    color: var(--muted);
    padding-block: 0.25rem 0.75rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    gap: 2rem clamp(1rem, 2vw, 1.75rem);
  }

  .empty {
    padding-block: 4rem;
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .empty button {
    padding: 0.55rem 1rem;
    border: 1px solid var(--ink);
    border-radius: 6px;
    background: var(--ink);
    color: var(--ground);
    cursor: pointer;
  }

  .foot {
    margin-top: 5rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .foot p {
    max-width: 60ch;
  }
</style>
